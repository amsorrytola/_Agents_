{
  "name": "yieldcraft-ai",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev:terminal": "tsx --watch index.ts",
    "dev:server": "tsx --watch server.ts",
    "start:quiet": "LOG_LEVEL=warn npm start",
    "start:debug": "LOG_LEVEL=debug npm start",
    "start:minimal": "LOG_LEVEL=error npm start",
    "clear-logs": "clear && npm start"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.73.2",
    "@langchain/core": "^0.3.0",
    "@langchain/groq": "^0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "hedera-agent-kit": "^3.0.1",
    "langchain": "^0.3.0",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "socket.io": "^4.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}